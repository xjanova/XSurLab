<Window x:Class="XSurLab.App.CalibrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Calibrate speakers · XSurLab" Width="820" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="#11151A" Foreground="#E4E9EF" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False" Closing="Window_Closing">
  <Border Style="{StaticResource Card}" Margin="16">
    <StackPanel>
      <TextBlock Text="CALIBRATE SPEAKERS" Style="{StaticResource Label}"/>
      <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
      <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,14"
                 Text="Pink noise at −20 dBFS RMS plays on one speaker at a time: 500 Hz–2 kHz on the mains, 20–120 Hz on the subwoofer. Measure at the listening position with an SPL meter (C weighting, slow) and trim every main speaker to the same reading; the line under bass management says where the subwoofer goes. Delay holds nearer speakers back so they arrive with the farthest one: 1 ms ≈ 34 cm. Applies to the monitor only, never to exports."/>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="86"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="SPEAKER" Style="{StaticResource Label}"/>
        <TextBlock Grid.Column="1" Text="NOISE" Style="{StaticResource Label}"/>
        <TextBlock Grid.Column="2" Text="TRIM / dB" Style="{StaticResource Label}"/>
        <TextBlock Grid.Column="4" Text="DELAY / ms" Style="{StaticResource Label}"/>
        <TextBlock Grid.Column="6" Text="DISTANCE / m" Style="{StaticResource Label}"/>
      </Grid>
      <!-- 7.1.4 has twelve rows: they scroll so Save and Cancel stay on screen at high display scaling. -->
      <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl ItemsSource="{Binding Speakers}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Speakers" Focusable="False">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border x:Name="Row" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="86"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Name" Text="{Binding Name}" FontWeight="SemiBold" FontFamily="Consolas"/>
                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11"/>
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding TestLabel}" Click="Test_Click" Tag="{Binding}" Padding="8,5" Margin="0,0,8,0" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding TestName}"/>
              <DockPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TrimText}" FontFamily="Consolas" FontSize="12" Width="52" TextAlignment="Right"/>
                <Slider Value="{Binding TrimDb}" Minimum="-20" Maximum="10" TickFrequency=".5" SmallChange=".5" LargeChange="3" Margin="0,4"
                        AutomationProperties.Name="{Binding TrimName}" AutomationProperties.HelpText="{Binding TrimText}"/>
              </DockPanel>
              <DockPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding DelayText}" FontFamily="Consolas" FontSize="12" Width="52" TextAlignment="Right"/>
                <Slider Value="{Binding DelayMs}" Minimum="0" Maximum="50" TickFrequency=".1" SmallChange=".1" LargeChange="1" Margin="0,4"
                        AutomationProperties.Name="{Binding DelayName}" AutomationProperties.HelpText="{Binding DelayText}"/>
              </DockPanel>
              <TextBox Grid.Column="6" Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Padding="6,4" MaxLength="8"
                       AutomationProperties.Name="{Binding DistanceName}" ToolTip="Listening distance in metres, for Delays from distances"/>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#2A2518"/>
              <Setter TargetName="Name" Property="Foreground" Value="#DDB879"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}">
        <Button Content="{Binding CycleLabel}" Click="Cycle_Click" ToolTip="Plays each speaker for 3 s, clockwise from front left; the subwoofer last"/>
        <Button Content="Stop noise" Click="StopNoise_Click"/>
        <Button Content="Delays from distances" Click="Distances_Click" ToolTip="Enter every speaker's distance to the listening position first"/>
        <Button Content="Reset to flat…" Click="Reset_Click"/>
      </StackPanel>
      <Grid Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <CheckBox Content="Bass management" IsChecked="{Binding BassManagement}" IsEnabled="{Binding CanBassManage}" VerticalAlignment="Center"
                  ToolTip="High-passes every main speaker at the crossover and plays the low end, with LFE, on the subwoofer"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Crossovers}" SelectedValue="{Binding CrossoverHz}" SelectedValuePath="Hz" Width="96" IsEnabled="{Binding CanSetCrossover}"
                  VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="Crossover frequency" ToolTip="Crossover frequency"/>
        <CheckBox Grid.Column="2" Content="LFE +10 dB" IsChecked="{Binding LfeGain}" IsEnabled="{Binding CanSetCrossover}" VerticalAlignment="Center"
                  ToolTip="The in-band gain mixes expect on LFE. Leave on when the subwoofer is trimmed to read the same as the mains."/>
        <StackPanel Grid.Column="4">
          <TextBlock Text="{Binding MonitorVolume, StringFormat='MONITOR / {0:P0}'}" Style="{StaticResource Label}"/>
          <!-- Small steps: clicking the track must not jump the noise to full level, least of all in Exclusive. -->
          <Slider Value="{Binding MonitorVolume}" Minimum="0" Maximum="1" TickFrequency=".01" SmallChange=".01" LargeChange=".05" Margin="0" AutomationProperties.Name="Monitor volume"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding BassHint}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding Status}" Foreground="#E0A060" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancel" IsCancel="True"/>
        <Button Content="Save calibration" Click="Save_Click" IsDefault="True" Margin="0" Background="#3E3527" BorderBrush="{StaticResource Accent}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
