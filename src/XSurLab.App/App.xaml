<Application x:Class="XSurLab.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:XSurLab.App" StartupUri="MainWindow.xaml">
  <Application.Resources><local:DisplayValueConverter x:Key="DisplayValue"/>
    <SolidColorBrush x:Key="Panel" Color="#191E25"/>
    <SolidColorBrush x:Key="Line" Color="#303944"/>
    <SolidColorBrush x:Key="Muted" Color="#94A2B4"/>
    <SolidColorBrush x:Key="Accent" Color="#DDB879"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4E9EF"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#242B34"/><Setter Property="Foreground" Value="#E4E9EF"/>
      <Setter Property="BorderBrush" Value="#45515F"/><Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#DDB879"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#10141A"/><Setter Property="Foreground" Value="#E4E9EF"/>
      <Setter Property="CaretBrush" Value="#DDB879"/><Setter Property="BorderBrush" Value="#45515F"/>
      <Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="#17222D"/>
      <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
        <TextBlock Text="{Binding Converter={StaticResource DisplayValue}}" Foreground="#17222D"/>
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E4E9EF"/><Setter Property="Margin" Value="0,6,20,6"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,8,0,14"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A2B4"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20"/>
    </Style>
  </Application.Resources>
</Application>

