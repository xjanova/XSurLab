<Window x:Class="XSurLab.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:XSurLab.App"
 Title="XSurLab · Surround Studio" Width="1280" Height="860" MinWidth="1120" MinHeight="820"
 Background="#11151A" Foreground="#E4E9EF" FontFamily="Segoe UI" FontSize="13"
 Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="XSurLab" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="SURROUND STUDIO / 0.3" Style="{StaticResource Label}" Margin="1,5,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="New" Click="New_Click" IsEnabled="{Binding CanEdit}" ToolTip="Ctrl+N"/>
        <Button Content="Open session" Click="Open_Click" IsEnabled="{Binding CanEdit}" ToolTip="Ctrl+O"/>
        <Button Content="Save session" Click="Save_Click" IsEnabled="{Binding CanEdit}" ToolTip="Ctrl+S"/>
        <Button Content="+ Import WAV" Click="Import_Click" IsEnabled="{Binding CanEdit}" Background="#3E3527" BorderBrush="{StaticResource Accent}" ToolTip="Ctrl+I"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
        <StackPanel IsEnabled="{Binding CanEdit}" Margin="0,0,20,0">
          <TextBlock Text="SESSION" Style="{StaticResource Label}"/>
          <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Session name" MaxLength="200"/>
        </StackPanel>
        <StackPanel Grid.Column="1" IsEnabled="{Binding CanEdit}" Margin="0,0,14,0">
          <TextBlock Text="SPEAKER LAYOUT" Style="{StaticResource Label}"/>
          <ComboBox ItemsSource="{Binding Layouts}" SelectedValue="{Binding Layout}" SelectedValuePath="Layout" AutomationProperties.Name="Speaker layout"/>
        </StackPanel>
        <StackPanel Grid.Column="2" IsEnabled="{Binding CanEdit}" Margin="0,0,14,0">
          <TextBlock Text="SAMPLE RATE" Style="{StaticResource Label}"/>
          <ComboBox ItemsSource="{Binding Rates}" SelectedItem="{Binding SampleRate}" AutomationProperties.Name="Sample rate"/>
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Text="{Binding MasterGainDb, StringFormat='MASTER / {0:F1} dB'}" Style="{StaticResource Label}"/>
          <Slider Value="{Binding MasterGainDb}" Minimum="-60" Maximum="6" TickFrequency=".5" Margin="0,5,0,0" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Master gain"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="5,4,5,15">
            <TextBlock Text="SOURCE TRACKS" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding TrackSummary}" FontSize="12"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
            <Button Content="Remove selected track" Click="Remove_Click" IsEnabled="{Binding CanEditSelected}" Margin="0,0,0,12"/>
            <TextBlock Text="Mono, stereo or multichannel WAV · 32 tracks&#10;Space play/stop · Esc stop · Ctrl+E export · Ctrl+D deliver" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanEdit}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9,12"/><Setter Property="Margin" Value="0,0,0,4"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="#DDB879"/>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8C99AA" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Summary}" Foreground="#8C99AA" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="SOURCE WAVEFORM" Style="{StaticResource Label}"/>
            <local:WaveformView Grid.Row="1" Audio="{Binding Selected.Audio}" Margin="0,4" AutomationProperties.Name="Selected source waveform"/>
            <TextBlock Grid.Row="2" Text="{Binding Selected.MediaPath, FallbackValue='No media selected', TargetNullValue='No media selected'}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="168"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Style="{StaticResource Tab}" Content="SPATIAL POSITION" IsChecked="{Binding ShowSpatial}" GroupName="View" AutomationProperties.Name="Show spatial position"/>
                <RadioButton Style="{StaticResource Tab}" Content="TRACK EQ" IsChecked="{Binding ShowEq}" GroupName="View" AutomationProperties.Name="Show track EQ"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding ShowSpatial, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding OutputLabels}" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="Drag to pan · stereo sources rotate as a ±30° pair · beds route by channel mask · inner ring = height speakers." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <local:PannerView Grid.Row="1" Layout="{Binding Layout}" Azimuth="{Binding Selected.Azimuth, Mode=TwoWay}" Elevation="{Binding Selected.Elevation, Mode=TwoWay}" Spread="{Binding Selected.Spread}" IsEnabled="{Binding CanPanSelected}" MinHeight="0" AutomationProperties.Name="Surround source position" Visibility="{Binding ShowSpatial, Converter={StaticResource Visible}}"/>
              <local:EqView Grid.Row="1" Eq="{Binding Selected.Eq, Mode=TwoWay}" SampleRate="{Binding SampleRate}" SelectedBand="{Binding EqBandIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditSelected}" MinHeight="0" Focusable="True" AutomationProperties.Name="Track EQ response" Visibility="{Binding ShowEq, Converter={StaticResource Visible}}"/>
              <Grid Grid.Row="2" Margin="0,10,0,0" IsEnabled="{Binding CanEditSelected}" Visibility="{Binding ShowEq, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,0,0,6">
                  <ComboBox ItemsSource="{Binding EqBandNames}" SelectedIndex="{Binding EqBandIndex}" Width="118" AutomationProperties.Name="EQ band" Margin="0,0,12,0"/>
                  <CheckBox Content="On" IsChecked="{Binding BandOn}" VerticalAlignment="Center" AutomationProperties.Name="EQ band on"/>
                  <TextBlock Text="{Binding BandText}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Accent}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="FREQUENCY" Style="{StaticResource Label}" Margin="0"/>
                <Slider Grid.Row="2" Value="{Binding BandFrequencyLog}" Minimum="1.30103" Maximum="4.30103" SmallChange=".02" LargeChange=".1" IsSnapToTickEnabled="False" AutomationProperties.Name="EQ band frequency" AutomationProperties.HelpText="{Binding BandText}" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="GAIN" Style="{StaticResource Label}" Margin="0"/>
                <Slider Grid.Row="2" Grid.Column="2" Value="{Binding BandGainDb}" Minimum="-24" Maximum="24" TickFrequency=".5" SmallChange=".5" LargeChange="3" IsEnabled="{Binding BandHasGain}" AutomationProperties.Name="EQ band gain" AutomationProperties.HelpText="{Binding BandText}" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="Q · WHEEL ON GRAPH" Style="{StaticResource Label}" Margin="0"/>
                <Slider Grid.Row="2" Grid.Column="4" Value="{Binding BandQLog}" Minimum="-1" Maximum="1" SmallChange=".02" LargeChange=".1" IsSnapToTickEnabled="False" IsEnabled="{Binding BandHasQ}" AutomationProperties.Name="EQ band Q" AutomationProperties.HelpText="{Binding BandText}" Margin="0,4,0,0"/>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel IsEnabled="{Binding CanEditSelected}">
                <TextBlock Text="CHANNEL STRIP" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Track name" MaxLength="200" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <CheckBox Content="Mute" IsChecked="{Binding Selected.Mute}"/>
                  <CheckBox Content="Solo" IsChecked="{Binding Selected.Solo}"/>
                </StackPanel>
                <TextBlock Text="{Binding Selected.GainDb, StringFormat='GAIN / {0:F1} dB'}" Margin="0,12,0,0"/>
                <Slider Value="{Binding Selected.GainDb}" Minimum="-60" Maximum="12" TickFrequency=".5" AutomationProperties.Name="Track gain"/>
                <TextBlock Text="{Binding Selected.Azimuth, StringFormat='AZIMUTH / {0:F0}°'}"/>
                <Slider Value="{Binding Selected.Azimuth}" Minimum="-180" Maximum="180" TickFrequency="1" AutomationProperties.Name="Source azimuth" IsEnabled="{Binding CanPanSelected}"/>
                <TextBlock Text="{Binding Selected.Elevation, StringFormat='ELEVATION / {0:F0}°'}"/>
                <Slider Value="{Binding Selected.Elevation}" Minimum="0" Maximum="90" TickFrequency="1" AutomationProperties.Name="Source elevation" IsEnabled="{Binding CanPanSelected}" Margin="0,8,0,2"/>
                <TextBlock Text="{Binding HeightHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Selected.Spread, StringFormat='SPREAD / {0:F0}°'}"/>
                <Slider Value="{Binding Selected.Spread}" Minimum="0" Maximum="360" TickFrequency="5" AutomationProperties.Name="Source spread" IsEnabled="{Binding CanPanSelected}"/>
                <TextBlock Text="{Binding Selected.LfeDb, StringFormat='LFE SEND / {0:F1} dB'}"/>
                <Slider Value="{Binding Selected.LfeDb}" Minimum="-60" Maximum="0" TickFrequency=".5" AutomationProperties.Name="LFE send" IsEnabled="{Binding CanSendLfe}"/>
                <TextBlock Text="−60 dB = off · 120 Hz low-pass" Style="{StaticResource Label}"/>
                <TextBlock Text="GROUP / STEM" Style="{StaticResource Label}" Margin="0,4,0,8"/>
                <TextBox Text="{Binding Selected.Group, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Track group" ToolTip="Stem name for Deliver, e.g. DX, MX, FX. Empty = Other." MaxLength="40" Margin="0,0,0,12"/>
                <TextBlock Text="START OFFSET / SECONDS" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Selected.StartSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Track start offset"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="OUTPUT / dBFS" Style="{StaticResource Label}"/>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="{Binding MomentaryText}" FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="{Binding ShortTermText}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding IntegratedText}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="{Binding TruePeakText}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                <TextBlock Text="BS.1770-4 · mix level, before monitor volume" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <local:MeterView x:Name="Meters" AutomationProperties.Name="Output channel meters"/>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="WASAPI / SHARED OUTPUT" Style="{StaticResource Label}"/>
            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" AutomationProperties.Name="Monitor output device"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Refresh outputs" Click="RefreshOutputs_Click" VerticalAlignment="Bottom"/>
          <CheckBox Grid.Column="2" Content="Stereo fold-down" IsChecked="{Binding StereoMonitor}" VerticalAlignment="Bottom" Margin="12,0,18,8" ToolTip="Clear to send the session's discrete channels. The device must have the matching Windows speaker layout."/>
          <StackPanel Grid.Column="3">
            <TextBlock Text="{Binding MonitorVolume, StringFormat='MONITOR / {0:P0}'}" Style="{StaticResource Label}"/>
            <Slider Value="{Binding MonitorVolume}" Minimum="0" Maximum="1" AutomationProperties.Name="Monitor volume"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="▶  Play monitor" Click="Play_Click" IsEnabled="{Binding CanPlay}" ToolTip="Space"/>
          <Button Content="■  Stop / cancel" Click="Stop_Click" ToolTip="Esc"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="{Binding RenderSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <ComboBox ItemsSource="{Binding Formats}" SelectedValue="{Binding ExportFormat}" SelectedValuePath="Format" Width="128" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Export sample format" Margin="0,0,10,0"/>
          <CheckBox Content="Dither" IsChecked="{Binding ExportDither}" IsEnabled="{Binding CanDither}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="TPDF dither of ±1 LSB before 16/24-bit quantisation"/>
          <CheckBox Content="BWF" IsChecked="{Binding ExportBroadcast}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Write a Broadcast WAV bext chunk with the measured loudness"/>
          <Button Content="Deliver…" Click="Deliver_Click" IsEnabled="{Binding CanRender}" ToolTip="Mix, multi-mono, stems and QC report · Ctrl+D"/>
          <Button Content="Export WAV →" Click="Export_Click" IsEnabled="{Binding CanRender}" Margin="0" Background="#3E3527" BorderBrush="{StaticResource Accent}" ToolTip="Ctrl+E"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
